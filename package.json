{
  "name": "meeting-room-booking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/patch-opennext.js",
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && wrangler dev",
    "deploy": "npm run build:worker && wrangler deploy",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "d1:migrate:local": "wrangler d1 migrations apply meeting-room-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply meeting-room-db --remote"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^4.156.0"
  }
}
